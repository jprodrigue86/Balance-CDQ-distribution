      "text": "\n<style id=\"cdqInventoryModernV2592Style\">\n#cdqInventoryModernV2592{position:fixed;left:0;right:0;z-index:905;background:#02070b;color:#eef8ff;overflow:hidden;font-family:Arial,Helvetica,sans-serif;-webkit-tap-highlight-color:transparent}\n#cdqInventoryModernV2592[hidden]{display:none!important}\n#cdqInventoryModernV2592 *{box-sizing:border-box}\n.cdq-im-shell{height:100%;max-width:980px;margin:0 auto;display:flex;flex-direction:column;background:radial-gradient(circle at 50% -10%,#092940 0,#030b11 42%,#000 78%)}\n.cdq-im-top{flex:0 0 auto;padding:9px 12px 8px;border-bottom:1px solid #0f5374;background:rgba(0,7,12,.92);box-shadow:0 4px 18px #000a}\n.cdq-im-head{display:flex;align-items:center;gap:10px}\n.cdq-im-title{min-width:0;flex:1}.cdq-im-title strong{display:block;font-size:25px;font-weight:950;letter-spacing:.01em}.cdq-im-title small{display:block;color:#2fe9ff;font-size:13px;margin-top:1px}\n.cdq-im-back,.cdq-im-close,.cdq-im-iconbtn{width:42px;height:42px;border:1px solid #2f6c88;border-radius:12px;background:#0a1821;color:#fff;font-size:22px;font-weight:900;display:grid;place-items:center}\n.cdq-im-back[hidden]{display:none!important}.cdq-im-close{font-size:19px}\n.cdq-im-body{flex:1 1 auto;min-height:0;overflow-y:auto;overflow-x:hidden;-webkit-overflow-scrolling:touch;padding:10px 12px 22px}\n.cdq-im-searchrow{display:grid;grid-template-columns:minmax(0,1fr) 52px;gap:7px;margin-bottom:10px}\n.cdq-im-search{height:50px;border:1.5px solid #0ea4dd;border-radius:13px;background:#071a26;color:#fff;font-size:16px;padding:0 13px;outline:none;box-shadow:inset 0 0 0 1px #082f44}\n.cdq-im-search::placeholder{color:#8aa7b8}.cdq-im-search:focus{border-color:#13d9ff;box-shadow:0 0 12px #0bd5ff44,inset 0 0 0 1px #14516d}\n.cdq-im-scanmini{border:1.5px solid #16b8ef;border-radius:13px;background:linear-gradient(#0c5b8d,#072e4c);color:#fff;font-size:23px;font-weight:900}\n.cdq-im-tiles{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:12