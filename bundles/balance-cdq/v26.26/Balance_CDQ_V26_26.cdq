    {
      "id": "inventory-local-normalize-v2625",
      "file": "Selector.html",
      "op": "replace_literal_if_present",
      "expected": 1,
      "search": "'use strict';\nif(window.cdqInventoryModernV2592)return;",
      "replacement": "'use strict';\nfunction normalize(v){return String(v==null?'':v).normalize('NFD').replace(/[\\u0300-\\u036f]/g,'').toLowerCase()}\nif(window.cdqInventoryModernV2592)return;"
    },
    {
      "id": "drive-default-files-setting-v2626",
      "file": "Selector.html",
      "op": "replace_literal",
      "search": "function defaultEmail(){\n  try{return String(typeof cdqDefaultGoogleAccountV2299===\"function\"?cdqDefaultGoogleAccountV2299():\"\").trim().toLowerCase();}catch(_){return \"\";}\n}",
      "replacement": "function defaultEmail(){\n  // V26.26: use the exported Files setting, not a private function in another IIFE.\n  // PDF and Sheets read this same key. Blank/reset must remain an explicit choice.\n  try{\n    const value=typeof window.cdqGoogleDefaultAccountV2294===\"function\"\n      ? window.cdqGoogleDefaultAccountV2294()\n      : localStorage.getItem(\"cdqDefaultGoogleAccountV2294\");\n    return String(value||\"\").trim().toLowerCase();\n  }catch(_){return \"\";}\n}",
      "expected": 1
    },
    {
      "id": "workspace-admin-once-v2626",
      "file": "Code.gs",
      "op": "replace_literal",
      "search": "function obtenirUtilisateursAutorises_() {\n  const admin = obtenirAdministrateurPrincipal_();",
      "replacement": "function obtenirUtilisateursAutorises_() {\n  cdqEnsureWorkspaceAdminV2626_();\n  const admin = obtenirAdministrateurPrincipal_();",
      "expected": 1
    },
    {
      "id": "drive-single-native-screen-v2626",
      "file": "Selector.html",
      "op": "replace_literal",
      "search": "  busy=true;\n  paint(forceAsk||!email?\"Choisissez le compte Google autorisé pour Drive.\":\"Vérification du compte Drive par défaut…\",email,\"\",true);\n  b.authorizeDriveBrowse(id,email,!!forceAsk||!email);\n  window.__cdqDriveGateNativeRequestV2620=id;",
      "replacement": "  busy=true;\n  // A native chooser or required Google consent owns the screen. No second CDQ dialog.\n  // With a default account, keep the normal CDQ screen while Drive is verified.\n  paint(\"Vérification du compte Drive…\",email,\"\",false);\n  window.__cdqDriveGateNativeRequestV2620=id;\n  try{b.authorizeDriveBrowse(id,email,!!forceAsk||!email);}\n  catch(e){window.__cdqDriveGateNativeRequestV2620=\"\";deny(email,e&&e.message||\"Connexion Google indisponible.\");}",
      "expected": 1
    },
    {
      "id": "drive-silent-web-default-v2626",
      "file": "Selector.html",
      "op": "replace_literal",
      "search": "  busy=true;paint(\"Vérification du compte Drive par défaut…\",email,\"\",true);",
      "replacement": "  busy=true;paint(\"Vérification du compte Drive par défaut…\",email,\"\",false);",
      "expected": 1
    },
    {
      "id": "drive-single-web-consent-v2626",
      "file": "Selector.html",
      "op": "replace_literal",
      "search": "  paint(\"Choisissez le compte Google autorisé pour Drive.\",\"\",\"\",true);",
      "replacement": "  paint(\"Choisissez le compte Google autorisé pour Drive.\",\"\",\"\",false);",
      "expected": 1
    },
    {
      "id": "drive-explicit-remember-choice-v2626",
      "file": "Selector.html",
      "op": "replace_literal",
      "search": "window.cdqNativeDriveGateV2620=function(id,ok,email,message){\n  if(String(id)!==String(window.__cdqDriveGateNativeRequestV2620||\"\"))return;\n  window.__cdqDriveGateNativeRequestV2620=\"\";\n  if(ok)allow(email);else deny(email,message);\n};",
      "replacement": "window.cdqNativeDriveGateV2620=function(id,ok,email,message,rememberDefault){\n  if(String(id)!==String(window.__cdqDriveGateNativeRequestV2620||\"\"))return;\n  window.__cdqDriveGateNativeRequestV2620=\"\";\n  // Remember only an explicitly requested choice AFTER Google and Drive validation.\n  if(ok&&rememberDefault===true){\n    try{\n      if(typeof window.cdqSetGoogleDefaultAccountV2294===\"function\")window.cdqSetGoogleDefaultAccountV2294(email);\n      else localStorage.setItem(\"cdqDefaultGoogleAccountV2294\",String(email||\"\").trim().toLowerCase());\n    }catch(_){}\n  }\n  if(ok)allow(email);else deny(email,message);\n};",
      "expected": 1
    }
  ],
