    {
      "id": "obtenirEtatAcces-direct-v2645",
      "file": "Code.gs",
      "op": "replace_literal_if_present",
      "search": "function obtenirEtatAcces(jetonAppareil, ticketGoogle) {\n  try {\n    nettoyerSessionsExpireesCDQ_();\n\n    const admin = obtenirAdministrateurPrincipal_();\n\n    // Chaque ouverture repart verrouillée. Le jeton appareil ou une identité\n    // Google vérifiée détermine seulement QUEL écran de sécurité afficher.\n    effacerSessionTemporaireCouranteCDQ_();\n\n    const jeton = String(jetonAppareil || '').trim();\n    const uAppareil = lireUtilisateurDepuisJetonAppareilCDQ_(jeton);\n\n    // Appareil déjà activé : aucune nouvelle connexion Google.\n    if (uAppareil) {\n      if (nip4DefiniUtilisateurCDQ_(uAppareil)) {\n        return {\n          versionBackend: CDQ_BACKEND_BUILD_,\n          autorise:false,\n          appareilConnu:true,\n          doitDeverrouiller:true,\n          typeConnexion:'nip4',\n          email:uAppareil.email,\n          role:uAppareil.role,\n          biometriePermise:true,\n          createur:uAppareil.email === admin,\n          message:'Déverrouillez l’application.'\n        };\n      }\n\n      if (uAppareil.email === admin) {\n        return {\n          versionBackend:CDQ_BACKEND_BUILD_, autorise:false,\n          activationValidee:true, doitCreerNip:true,\n          email:admin, role:'admin', createur:true,\n          jetonActivation:creerJetonActivationCDQ_(uAppareil),\n          message:'Choisissez votre NIP de créateur.'\n        };\n      }\n\n      return {\n        versionBackend: CDQ_BACKEND_BUILD_,\n        autorise:false,\n        appareilConnu:true,\n        doitActiverNip:true,\n        typeConnexion:'activation6',\n        email:uAppareil.email,\n        role:uAppareil.role,\n        message:'Entrez votre clé d’activation à usage unique, puis choisissez votre NIP.'\n      };\n    }\n\n    // V26.19 : aucun appareil connu. On affiche directement le formulaire\n    // CDQ (courriel autorisé + code d’activation). Le compte Google sera choisi\n    // séparément seulement lorsqu’un fichier Drive/Sheets/PDF en aura besoin.\n    return {\n      versionBackend: CDQ_BACKEND_BUILD_,\n      autorise:false,\n      connexionRequise:true,\n      oublierJeton: !!jeton,\n      typeConnexion:'activation6',\n      emailSuggere:'',\n      message:'Entrez votre adresse courriel autorisée et votre code d’activation à 6 chiffres.'\n    };\n\n    // Aucun appareil connu : l'identité vient UNIQUEMENT de Google Identity\n    // Services. On ne dépend plus de Session.getActiveUser() ni de la page\n    // de connexion Apps Script.\n    const identiteGoogle = lireTicketGoogleCDQ_(ticketGoogle);\n    if (!identiteGoogle) {\n      return {\n        versionBackend: CDQ_BACKEND_BUILD_,\n        autorise:false,\n        connexionGoogleRequise:true,\n        oublierJeton: !!jeton,\n        typeConnexion:'google',\n        message:'Connectez votre compte Google pour continuer.'\n      };\n    }\n\n    const uGoogle = trouverUtilisateurAutoriseParEmail_(identiteGoogle.email);\n    if (!uGoogle) {\n      supprimerTicketGoogleCDQ_(ticketGoogle);\n      return {\n        versionBackend: CDQ_BACKEND_BUILD_,\n        autorise:false,\n        connexionGoogleRequise:true,\n        oublierJeton: !!jeton,\n        typeConnexion:'google',\n        message:'Ce compte Google n’est plus autorisé.'\n      };\n    }\n\n    // Un utilisateur déjà inscrit qui change de téléphone n'a PAS besoin d'une\n    // nouvelle clé d'activation : Google + son NIP recréent seulement le jeton\n    // local du nouvel appareil.\n    if (nip4DefiniUtilisateurCDQ_(uGoogle)) {\n      const nouveauJeton = creerJetonAppareilCDQ_(uGoogle);\n      supprimerTicketGoogleCDQ_(ticketGoogle);\n      return {\n        versionBackend: CDQ_BACKEND_BUILD_,\n        autorise:false,\n        appareilConnu:true,\n        doitDeverrouiller:true,\n        typeConnexion:'nip4',\n        email:uGoogle.email,\n        role:uGoogle.role,\n        biometriePermise:true,\n        createur:uGoogle.email === admin,\n        jetonAppareil:nouveauJeton,\n        message:'Entrez votre NIP à 4 chiffres.'\n      };\n    }\n\n    if (uGoogle.email === admin) {\n      supprimerTicketGoogleCDQ_(ticketGoogle);\n      return {\n        versionBackend:CDQ_BACKEND_BUILD_, autorise:false,\n        activationValidee:true, doitCreerNip:true,\n        email:admin, role:'admin', createur:true,\n        jetonActivation:creerJetonActivationCDQ_(uGoogle),\n        message:'Choisissez votre NIP à 4 chiffres.'\n      };\n    }\n\n    // Première inscription d'un technicien : Google est déjà confirmé.\n    // La clé à 6 chiffres est demandée une seule fois, puis elle est consommée.\n    return {\n      versionBackend: CDQ_BACKEND_BUILD_,\n      autorise:false,\n      doitActiverNip:true,\n      connexionGoogleValidee:true,\n      typeConnexion:'activation6',\n      email:uGoogle.email,\n      role:uGoogle.role,\n      message:'Compte Google confirmé. Entrez maintenant votre clé d’activation à usage unique.'\n    };\n  } catch(e) {\n    return {\n      versionBackend: CDQ_BACKEND_BUILD_,\n      autorise:false,\n      connexionGoogleRequise:true,\n      typeConnexion:'google',\n      message:e && e.message ? e.message : String(e)\n    };\n  }\n}",
      "replacement": "function obtenirEtatAcces(jetonAppareil, ticketGoogle) {\n  return cdqDirectAccessV2645_(jetonAppareil,ticketGoogle);\n}",
      "expected": 1
    },
    {
      "id": "connecterAvecCodeAccesVerrouille_-direct-v2645",
      "file": "Code.gs",
      "op": "replace_literal_if_present",
      "search": "function connecterAvecCodeAccesVerrouille_(email, code, ticketGoogle, jetonAppareil) {\n  email = normaliserEmailCDQ_(email);\n  code = String(code || '').trim();\n\n  if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) throw new Error('Adresse courriel invalide.');\n  if (!codeAccesValideCDQ_(code)) throw new Error('Le code d’activation doit contenir 6 chiffres.');\n\n  const identiteActivation = verifierIdentiteActivationCDQ_(email, ticketGoogle, jetonAppareil);\n\n  const blocage = verifierBlocageConnexionCDQ_(email);\n  if (blocage.bloque) {\n    throw new Error('Trop de tentatives. Attendez 10 minutes avant de réessayer.');\n  }\n\n  const u = trouverUtilisateurAutoriseParEmail_(email);\n  if (!u || !codeDefiniUtilisateurCDQ_(u) || !verifierCodeUtilisateurCDQ_(u, code)) {\n    const echec = enregistrerEchecConnexionCDQ_(email);\n    if (echec.bloque) throw new Error('Trop de tentatives. Accès temporairement bloqué pendant 10 minutes.');\n    if (u && !codeDefiniUtilisateurCDQ_(u)) {\n      if (nip4DefiniUtilisateurCDQ_(u)) {\n        throw new Error('Ce code à 6 chiffres a déjà été utilisé. Déverrouillez plutôt avec votre NIP à 4 chiffres.');\n      }\n      throw new Error('Aucun code d’activation valide. Demandez à l’administrateur de générer un nouveau code.');\n    }\n    throw new Error('Adresse courriel ou code d’activation incorrect.');\n  }\n\n  effacerEchecsConnexionCDQ_(email);\n\n  // Le code 6 chiffres est consommé IMMÉDIATEMENT.\n  revoquerSessionsUtilisateur_(email);\n  const jetonActivation = creerJetonActivationCDQ_(u);\n  consommerCodeActivationCDQ_(email);\n  if (identiteActivation.type === 'google') supprimerTicketGoogleCDQ_(ticketGoogle);\n\n  return {\n    autorise: false,\n    activationValidee: true,\n    doitCreerNip: true,\n    email: u.email,\n    role: u.role,\n    jetonActivation: jetonActivation,\n    message: 'Code accepté. Choisissez maintenant votre NIP à 4 chiffres.'\n  };\n}",
      "replacement": "function connecterAvecCodeAccesVerrouille_(email, code, ticketGoogle, jetonAppareil) {\n  return cdqDirectActivateV2645_(email,code,ticketGoogle,jetonAppareil);\n}",
      "expected": 1
    },
    {
      "id": "reprendreActivationCDQ-direct-v2645",
      "file": "Code.gs",
      "op": "replace_literal_if_present",
      "search": "function reprendreActivationCDQ(jetonActivation) {\n  const a = lireJetonActivationCDQ_(jetonActivation);\n  if (!a) throw new Error('Cette activation a expiré. Demandez un nouveau code à 6 chiffres à l’administrateur.');\n  const u = trouverUtilisateurAutoriseParEmail_(a.email);\n  if (!u) throw new Error('Accès retiré par l’administrateur.');\n  return {autorise:false, activationValidee:true, doitCreerNip:true,\n    email:u.email, role:u.role, jetonActivation:String(jetonActivation),\n    expirationActivation:a.expiresAt};\n}",
      "replacement": "function reprendreActivationCDQ(jetonActivation) {\n  return cdqDirectFinishActivationV2645_(jetonActivation);\n}",
      "expected": 1
    },
    {
      "id": "restaurerSessionApresBiometrie-direct-v2645",
      "file": "Code.gs",
      "op": "replace_literal_if_present",
      "search": "function restaurerSessionApresBiometrie(jetonAppareil) {\n  jetonAppareil = String(jetonAppareil || '').trim();\n  if (!jetonAppareil) throw new Error('Cet appareil n’est pas enregistré.');\n\n  const u = lireUtilisateurDepuisJetonAppareilCDQ_(jetonAppareil);\n  if (!u) throw new Error('Cet appareil n’est plus autorisé.');\n  if (!nip4DefiniUtilisateurCDQ_(u)) throw new Error('Configurez d’abord votre NIP à 4 chiffres.');\n\n  lierCleTemporaireCDQ_(u); // compatibilité seulement\n  const jetonSession = creerSessionRpcCDQ_(u);\n  return cdqStartupCachedV2527_({ autorise:true, email:u.email, role:u.role, jetonSession:jetonSession });\n}",
      "replacement": "// Compatibility endpoint; no local biometric or PIN verification.\nfunction restaurerSessionApresBiometrie(jetonAppareil) {\n  return cdqDirectAccessV2645_(jetonAppareil,'');\n}",
      "expected": 1
    },
