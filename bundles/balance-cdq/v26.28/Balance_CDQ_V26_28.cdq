      "replacement": "function connecterAvecCodeAcces(email, code, ticketGoogle, jetonAppareil) {\n  if (arguments[4] && arguments[4].creatorRecovery === true) {\n    return cdqCreatorRecoveryV2628_(email, code, ticketGoogle, arguments[4]);\n  }",
