      "replacement": "function cdqTraiterCredentialGoogleV42(d){\n  if(window.cdqCreatorRecoveryV2628&&window.cdqCreatorRecoveryV2628.isActive()){window.cdqCreatorRecoveryV2628.credential(d);return;}",
      "expected": 1
    },
    {
      "id": "creator-recovery-interface-v2628",
      "file": "Selector.html",
      "op": "insert_before_literal",
      "before": "</body>",
      "text": "\n<style id=\"cdq-creator-style-v2628\">.cdq-creator-recovery-v2628{margin-top:12px;text-align:left}.cdq-creator-recovery-v2628 p{overflow-wrap:anywhere;line-height:1.45}.cdq-creator-recovery-v2628 label{display:block;margin:12px 0 6px}.cdq-creator-recovery-v2628 input:not([type=checkbox]){box-sizing:border-box;width:100%;padding:14px;border-radius:14px;border:1px solid #657180;background:#101318;color:#fff;font-size:22px}.cdq-creator-recovery-v2628 button,.cdq-creator-entry-v2628{box-sizing:border-box;width:100%;min-height:48px;margin-top:10px;padding:12px;border:1px solid #4389ad;border-radius:12px;background:#123b53;color:#fff;font-weight:bold}.cdq-creator-recovery-v2628 .secondary,.cdq-creator-entry-v2628{background:#242b33;border-color:#68737f}.cdq-creator-recovery-v2628 .recovery-error{color:#ffb5b5}.cdq-creator-recovery-v2628 .reset-confirm{font-size:14px}.cdq-creator-recovery-v2628 .reset-confirm input{width:auto;margin-right:6px}.cdq-creator-recovery-v2628 a{color:#8ad4ff}.cdq-creator-recovery-v2628 button:disabled{opacity:.6}</style>\n<script id=\"cdq-creator-recovery-v2628\">\n/* CDQ creator recovery: Google verifies identity; the server alone grants access. */\n(function(){\n'use strict';\nif(window.cdqCreatorRecoveryV2628)return;\nconst OWNER='jp.rodrigue86@gmail.com';\nconst MANAGER='https://jprodrigue86.github.io/Balance-CDQ-distribution/apps-script-manager/?bundle=v26.28';\nlet active=false,busy=false,seq=0,ticket='',owner='',hasPin=false,mode='google',panel=null;\nfunction el(tag,text){const n=document.createElement(tag);if(text)n.textContent=text;return n;}\nfunction errorText(e){return String(e&&e.message||e||'La récupération n’a pas abouti. Réessayez.');}\nfunction rpc(name,args){return new Promise(function(resolve,reject){try{cdqApiRun().withSuccessHandler(resolve).withFailureHandler(reject)[name].apply(null,args);}catch(e){reject(e);}});}\nfunction hideGoogle(){cdqGoogleAuthPendingV42=false;cdqGooglePromptDelegatedV42=false;cdqPostToPwa({type:'CDQ_GOOGLE_AUTH_HIDE',authProtocol:42});}\nfunction getPanel(){\n if(panel)return panel;\n panel=el('div');panel.id='cdqCreatorPanelV2628';panel.className='cdq-creator-recovery-v2628';panel.style.display='none';\n const card=document.querySelector('#accessOverlay .access-card');if(card)card.appendChild(panel);return panel;\n}\nfunction button(text,fn,secondary){const b=el('button',text);b.type='button';if(secondary)b.className='secondary';b.onclick=fn;return b;}\nfunction field(id,label){const l=el('label',label),i=el('input');l.htmlFor=id;i.id=id;i.type='password';i.inputMode='numeric';i.maxLength=4;i.autocomplete=mode==='new'?'new-password':'current-password';i.placeholder='••••';i.addEventListener('input',function(){i.value=i.value.replace(/\\D/g,'').slice(0,4);});panel.append(l,i);return i;}\nfunction render(message,isError){\n const p=getPanel();cdqMasquerPanneauxAcces();p.replaceChildren();p.style.display='block';\n const overlay=document.getElementById('accessOverlay');if(overlay)overlay.style.display='flex';\n const status=document.getElementById('accessStatus');if(status)status.textContent='Récupération de l’accès créateur';\n cdqNettoyerErreurAcces();cdqSetAccessState('input');\n p.appendChild(el('p',owner||OWNER));\n if(message){const m=el('p',message);m.className=isError?'recovery-error':'recovery-info';m.setAttribute('role',isError?'alert':'status');p.appendChild(m);}\n if(mode==='pin'){\n  field('cdqCreatorPinV2628','Votre NIP personnel à 4 chiffres');\n  p.appendChild(button('Réactiver cet appareil',function(){submit(false);}));\n  p.appendChild(button('J’ai oublié mon NIP',function(){mode='new';render('Choisissez un nouveau NIP. Les anciennes sessions de votre compte seront révoquées.',false);},true));\n }else if(mode==='new'){\n  field('cdqCreatorPinV2628','Choisissez votre NIP personnel');field('cdqCreatorConfirmV2628','Confirmez votre NIP');\n  if(hasPin){const l=el('label'),c=el('input');c.type='checkbox';c.id='cdqCreatorResetConfirmV2628';l.className='reset-confirm';l.append(c,document.createTextNode(' Je confirme le remplacement de mon NIP et la révocation de mes anciennes sessions.'));p.appendChild(l);}\n  p.appendChild(button('Enregistrer et réactiver',function(){submit(true);}));\n  if(hasPin)p.appendChild(button('Garder mon NIP actuel',function(){mode='pin';render();},true));\n }else if(mode==='server'){\n  const a=el('a','Ouvrir le correctif Apps Script V26.28');a.href=MANAGER;a.target='_blank';a.rel='noopener';p.appendChild(a);\n  p.appendChild(button('Réessayer après le déploiement',start));\n }else if(!busy){p.appendChild(button('Confirmer mon compte Google créateur',start));}\n if(!busy)p.appendChild(button('Annuler',cancel,true));\n if(busy)p.querySelectorAll('button,input').forEach(function(n){n.disabled=true;});\n}\nfunction fail(e){busy=false;hideGoogle();render(errorText(e),true);}\nasync function start(){\n if(busy)return;active=true;busy=true;ticket='';owner='';hasPin=false;mode='google';const id=++seq;\n render('Vérification du service de récupération…',false);\n try{\n  const state=await rpc('obtenirEtatAcces',['','']);if(id!==seq||!active)return;\n  const m=String(state&&state.versionBackend||'').match(/-v(\\d+)\\.(\\d+)/i);\n  if(!m||Number(m[1])*100+Number(m[2])<2628){busy=false;mode='server';render('Déployez le petit correctif Apps Script V26.28 une fois. Il ne réimporte aucune donnée.',true);return;}\n  busy=false;cdqDemanderConnexionGoogleV42('Récupération créateur : confirmez '+OWNER+'. Aucun code administrateur à générer.');\n }catch(e){if(id===seq&&active)fail(e);}\n}\nasync function credential(data){\n if(!active||busy||!data||!data.credential||!data.challengeId)return;\n busy=true;const id=seq;cdqGoogleAuthPendingV42=true;\n try{\n  const proof=await rpc('verifierJetonGoogleCDQ',[String(data.credential),String(data.challengeId)]);\n  if(id!==seq||!active)return;\n  if(!proof||!proof.ok||!proof.ticket||String(proof.email||'').trim().toLowerCase()!==OWNER)throw Error('Choisissez le compte Google créateur '+OWNER+'. Le compte Drive et les autres comptes administrateurs ne remplacent pas cette vérification.');\n  ticket=String(proof.ticket);owner=String(proof.email);hideGoogle();\n  const state=await rpc('connecterAvecCodeAcces',[owner,'',ticket,'',{creatorRecovery:true,action:'state'}]);\n  if(id!==seq||!active)return;\n  if(!state||state.creatorRecovery!==true||state.email!==OWNER)throw Error('Le serveur n’a pas confirmé l’accès créateur.');\n  hasPin=state.hasPin===true;mode=hasPin?'pin':'new';busy=false;\n  render(hasPin?'Votre NIP a été conservé. Entrez-le pour réenregistrer ce téléphone.':'Compte créateur confirmé. Choisissez votre NIP personnel.',false);\n }catch(e){if(id===seq&&active){ticket='';owner='';mode='google';fail(e);}}\n}\nasync function submit(newPin){\n if(!active||busy||!ticket)return;\n const p=document.getElementById('cdqCreatorPinV2628'),c=document.getElementById('cdqCreatorConfirmV2628'),r=document.getElementById('cdqCreatorResetConfirmV2628');\n const nip=String(p&&p.value||''),confirmation=String(c&&c.value||'');\n if(!/^\\d{4}$/.test(nip)){render('Entrez exactement 4 chiffres.',true);return;}\n if(newPin&&nip!==confirmation){render('Les deux NIP ne correspondent pas.',true);return;}\n if(newPin&&hasPin&&!(r&&r.checked)){render('Confirmez le remplacement de votre NIP avant de continuer.',true);return;}\n const opts={creatorRecovery:true,action:newPin?'set-pin':'unlock',confirmation:confirmation,confirmReset:newPin&&hasPin&&!!(r&&r.checked)};\n busy=true;const id=seq;p.value='';if(c)c.value='';render('Vérification sécurisée…',false);\n try{\n  const state=await rpc('connecterAvecCodeAcces',[owner,nip,ticket,'',opts]);\n  if(id!==seq||!active)return;\n  if(!state||state.autorise!==true||state.email!==OWNER||!state.jetonAppareil||!state.jetonSession)throw Error('Récupération non confirmée. Aucun accès n’a été ouvert.');\n  ticket='';owner='';active=false;busy=false;seq++;hideGoogle();getPanel().style.display='none';\n  cdqSauverJetonAppareil(state.jetonAppareil);\n  if(cdqEstAndroid()&&cdqPwaAvailable())cdqPostToPwa({type:'CDQ_BIOMETRIC_REGISTER',email:state.email});\n  appliquerAccesAutorise(state);\n }catch(e){if(id===seq&&active)fail(e);}\n}\nfunction cancel(){if(busy)return;seq++;active=false;ticket='';owner='';hideGoogle();getPanel().replaceChildren();getPanel().style.display='none';afficherConnexionCodePersonnel('Connexion Balance CDQ','');}\nconst oldHide=cdqMasquerPanneauxAcces;\ncdqMasquerPanneauxAcces=function(){if(panel)panel.style.display='none';return oldHide.apply(this,arguments);};\nconst oldGoogleError=cdqAfficherErreurGoogleV42;\ncdqAfficherErreurGoogleV42=function(message){if(active){mode='google';fail(message);return;}return oldGoogleError.apply(this,arguments);};\nfor(const parentId of ['accessLogin','accessUnlock']){\n const host=document.getElementById(parentId);if(!host)continue;\n const b=button('Récupérer mon accès créateur',start,true);b.classList.add('cdq-creator-entry-v2628');b.id='cdqCreatorEntryV2628-'+parentId;host.appendChild(b);\n}\nwindow.cdqCreatorRecoveryV2628=Object.freeze({isActive:function(){return active;},credential:credential,start:start,cancel:cancel});\n})();\n\n</script>\n"
    }
  ],
