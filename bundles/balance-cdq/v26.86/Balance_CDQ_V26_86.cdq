    {
      "id": "definirNip4ApresActivation-direct-v2645",
      "file": "Code.gs",
      "op": "replace_literal_if_present",
      "search": "function definirNip4ApresActivation(email, jetonActivation, nip, confirmation) {\n  const lock = LockService.getScriptLock();\n  if (!lock.tryLock(15000)) throw new Error('Une vérification est déjà en cours. Réessayez dans un instant.');\n  try { return definirNip4ApresActivationVerrouille_(email, jetonActivation, nip, confirmation); }\n  finally { lock.releaseLock(); }\n}",
      "replacement": "",
      "expected": 1
    },
    {
      "id": "definirNip4ApresActivationVerrouille_-direct-v2645",
      "file": "Code.gs",
      "op": "replace_literal_if_present",
      "search": "function definirNip4ApresActivationVerrouille_(email, jetonActivation, nip, confirmation) {\n  email = normaliserEmailCDQ_(email);\n  nip = String(nip || '').trim();\n  confirmation = String(confirmation || '').trim();\n\n  if (!nip4ValideCDQ_(nip)) throw new Error('Le NIP doit contenir exactement 4 chiffres.');\n  if (nip !== confirmation) throw new Error('Les deux NIP ne correspondent pas.');\n\n  const activation = lireJetonActivationCDQ_(jetonActivation);\n  if (!activation || activation.email !== email) {\n    throw new Error('Activation expirée. Demandez un nouveau code à 6 chiffres à l’administrateur.');\n  }\n\n  const uAvant = trouverUtilisateurAutoriseParEmail_(email);\n  if (!uAvant) throw new Error('Utilisateur introuvable.');\n\n  sauvegarderNip4UtilisateurCDQ_(email, nip);\n\n  const u = trouverUtilisateurAutoriseParEmail_(email);\n  const jetonAppareil = creerJetonAppareilCDQ_(u);\n\n  // La clé temporaire Apps Script est facultative depuis V21.58. Elle est\n  // conservée comme compatibilité lorsqu'elle existe, mais les techniciens\n  // connectés par Google Identity Services utilisent la session RPC.\n  lierCleTemporaireCDQ_(u);\n  const jetonSession = creerSessionRpcCDQ_(u);\n\n  PropertiesService.getScriptProperties().deleteProperty(activation.cle);\n\n  return {\n    autorise:true,\n    email:u.email,\n    role:u.role,\n    jetonAppareil:jetonAppareil,\n    jetonSession:jetonSession,\n    nipConfigure:true\n  };\n}",
      "replacement": "",
      "expected": 1
    },
    {
      "id": "deverrouillerAvecNip-direct-v2645",
      "file": "Code.gs",
      "op": "replace_literal_if_present",
      "search": "function deverrouillerAvecNip(jetonAppareil, nip) {\n  jetonAppareil = String(jetonAppareil || '').trim();\n  nip = String(nip || '').trim();\n\n  if (!jetonAppareil) throw new Error('Cet appareil n’est pas encore enregistré.');\n  if (!nip4ValideCDQ_(nip)) throw new Error('Entrez votre NIP à 4 chiffres.');\n\n  const u = lireUtilisateurDepuisJetonAppareilCDQ_(jetonAppareil);\n  if (!u) throw new Error('Cet appareil n’est plus autorisé. Reconnectez-vous avec un nouveau code à 6 chiffres.');\n\n  const blocage = verifierBlocageConnexionCDQ_(u.email);\n  if (blocage.bloque) throw new Error('Trop de tentatives. Attendez 10 minutes avant de réessayer.');\n\n  if (!nip4DefiniUtilisateurCDQ_(u) || !verifierNip4UtilisateurCDQ_(u, nip)) {\n    const echec = enregistrerEchecConnexionCDQ_(u.email);\n    if (echec.bloque) throw new Error('Trop de tentatives. NIP temporairement bloqué pendant 10 minutes.');\n    throw new Error('NIP incorrect.');\n  }\n\n  effacerEchecsConnexionCDQ_(u.email);\n  lierCleTemporaireCDQ_(u); // compatibilité seulement\n  const jetonSession = creerSessionRpcCDQ_(u);\n\n  return cdqStartupCachedV2527_({ autorise:true, email:u.email, role:u.role, jetonSession:jetonSession });\n}",
      "replacement": "",
      "expected": 1
    },
